PORT=3000

# Database - PostgreSQL
# Read directly by src/infra/config/database/postgresql/pg.ts (pg.Pool config),
# not parsed from a single connection-string URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=scaling_app

# Database - MongoDB
# Read by src/infra/config/database/mongodb/mongo-database.ts. Non-fatal if
# unreachable (see server.ts) — backs the KYC dossier archive only (see
# src/infra/persistence/mongodb/mongo-kyc-dossier-repository.ts); nothing in
# the account/wallet/remittance write path touches it.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_DATABASE=money_across_borders

# Cache / idempotency store - Redis
# Read by src/infra/config/database/redis/redisClient.ts. Unlike Mongo/
# RabbitMQ, this one IS load-bearing: server.ts fails fast if it's
# unreachable, since IdempotentDecorator's claim()/save() (account, wallet,
# remittance) now runs against Redis instead of Postgres.
REDIS_HOST=localhost
REDIS_PORT=6379
#REDIS_PASSWORD=your-password

# Message Broker - RabbitMQ
# Read by src/infra/config/message-broker/rabbitmq-connection.ts. Non-fatal
# if unreachable (see server.ts). account.created (simulating a confirmation
# email) reaches this via the Transactional Outbox now, not a direct publish
# from CreateAccountUseCase — see src/infra/persistence/postgresql/
# postgres-outbox-repository.ts and src/infra/events/consumers/
# outbox-relay.ts (npm run worker:outbox-relay). A down broker just delays
# that email simulation until the relay can reach it again, not lose it.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# RabbitMQ retry/DLQ topology (account.created), read by
# src/infra/events/consumers/account-created-consumer.ts via
# src/infra/resilience/resilience-config.ts. See docs/resilience.md.
# Optional — both have defaults.
#RABBITMQ_MAX_RETRIES=3
#RABBITMQ_RETRY_DELAY_MS=5000

# Resilience layer (timeout/retry/backoff/circuit breaker) for synchronous
# external-provider calls — read by src/infra/resilience/resilience-config.ts.
# Today's only caller is HttpExchangeRateProvider (FX_PROVIDER=http below).
# See docs/resilience.md. All optional — each has a default.
#HTTP_TIMEOUT_MS=2000
#RETRY_MAX_ATTEMPTS=3
#RETRY_BASE_DELAY_MS=200
#RETRY_MAX_DELAY_MS=5000
#RETRY_JITTER_MS=100
#CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
#CIRCUIT_BREAKER_RESET_TIMEOUT_MS=10000

# FX provider selection, read by src/infra/factories/remittance-factory.ts.
# "mock" (default, unset or any other value) keeps SendRemittanceUseCase on
# the existing static-table MockExchangeRateProvider — unchanged production
# behavior. "http" switches to HttpExchangeRateProvider, a real HTTP call
# guarded by the resilience layer above, against FX_PROVIDER_URL — nothing
# runs at that URL by default; point it at src/infra/exchange/fake-fx-server.ts
# (started separately) for a local demo. See docs/resilience.md.
#FX_PROVIDER=mock
#FX_PROVIDER_URL=http://localhost:4010

# Outbox relay poll interval (ms), read by
# src/infra/events/consumers/outbox-relay.ts. Optional — defaults to 5000.
#OUTBOX_RELAY_INTERVAL_MS=5000

# Kafka outbox relay poll interval (ms), read by
# src/infra/events/consumers/kafka-outbox-relay.ts. Independent of
# OUTBOX_RELAY_INTERVAL_MS above — separate relay, separate broker. Optional
# — defaults to 5000.
#KAFKA_OUTBOX_RELAY_INTERVAL_MS=5000

# Event stream - Kafka
# Read by src/infra/config/message-broker/kafka-connection.ts. Non-fatal if
# unreachable, same as RabbitMQ above: the one thing wired to it today
# (remittance.completed, published by SendRemittanceUseCase) is a
# best-effort read-model update, not a correctness guarantee for the
# remittance itself — see src/infra/events/kafka-event-publisher.ts and
# CLAUDE.md's EventPublisher note for why this is Kafka and not RabbitMQ.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=money-across-borders

# Search / read model - Elasticsearch
# Read by src/infra/config/database/elasticsearch/elasticsearch-client.ts.
# Non-fatal at boot (see server.ts) — backs GET /remittances only; nothing
# in the account/wallet/remittance write path touches it.
ELASTICSEARCH_URL=http://localhost:9200

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Environment
NODE_ENV=development

# Observability
# Read by src/infra/observability/{logger,metrics,tracing}.ts. Loki/Tempo are
# optional at boot: an unreachable one degrades to stdout-only logging / no
# tracing rather than failing the app. GET /metrics is always exposed
# regardless of these vars — Prometheus scrapes it directly, no push involved.
LOG_LEVEL=info
LOKI_URL=http://localhost:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=money-across-borders
