PORT=3000

# Database - PostgreSQL
# Read directly by src/infra/config/database/postgresql/pg.ts (pg.Pool config),
# not parsed from a single connection-string URL.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DATABASE=scaling_app

# Database - MongoDB
# Read by src/infra/config/database/mongodb/mongo-database.ts. Non-fatal if
# unreachable (see server.ts) — backs the KYC dossier archive only (see
# src/infra/persistence/mongodb/mongo-kyc-dossier-repository.ts); nothing in
# the account/wallet/remittance write path touches it.
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USER=admin
MONGO_PASSWORD=admin
MONGO_DATABASE=money_across_borders

# Cache / idempotency store - Redis
# Read by src/infra/config/database/redis/redisClient.ts. Unlike Mongo/
# RabbitMQ, this one IS load-bearing: server.ts fails fast if it's
# unreachable, since IdempotentDecorator's claim()/save() (account, wallet,
# remittance) now runs against Redis instead of Postgres.
REDIS_HOST=localhost
REDIS_PORT=6379
#REDIS_PASSWORD=your-password

# Message Broker - RabbitMQ
# Read by src/infra/config/message-broker/rabbitmq-connection.ts. Non-fatal
# if unreachable (see server.ts): the one thing wired to it today
# (account.created, published by CreateAccountUseCase to simulate a
# confirmation email — see src/infra/events/) is a best-effort side effect,
# not a correctness guarantee, so a down broker just means the "email" isn't
# simulated for that signup, not that signup itself fails.
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Event stream - Kafka
# Read by src/infra/config/message-broker/kafka-connection.ts. Non-fatal if
# unreachable, same as RabbitMQ above: the one thing wired to it today
# (remittance.completed, published by SendRemittanceUseCase) is a
# best-effort read-model update, not a correctness guarantee for the
# remittance itself — see src/infra/events/kafka-event-publisher.ts and
# CLAUDE.md's EventPublisher note for why this is Kafka and not RabbitMQ.
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=money-across-borders

# Search / read model - Elasticsearch
# Read by src/infra/config/database/elasticsearch/elasticsearch-client.ts.
# Non-fatal at boot (see server.ts) — backs GET /remittances only; nothing
# in the account/wallet/remittance write path touches it.
ELASTICSEARCH_URL=http://localhost:9200

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-here

# Environment
NODE_ENV=development

# Observability
# Read by src/infra/observability/{logger,metrics,tracing}.ts. Loki/Tempo are
# optional at boot: an unreachable one degrades to stdout-only logging / no
# tracing rather than failing the app. GET /metrics is always exposed
# regardless of these vars — Prometheus scrapes it directly, no push involved.
LOG_LEVEL=info
LOKI_URL=http://localhost:3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=money-across-borders
