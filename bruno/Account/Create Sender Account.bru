meta {
  name: Create Sender Account
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/account
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

script:pre-request {
  bru.setVar("senderEmail", "sender+" + Date.now() + "@test.com");
}

body:json {
  {
    "email": "{{senderEmail}}",
    "password": "pass1234"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("senderAccountId", res.getBody().result.accountId);
  }
}

tests {
  test("status is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("account is OPEN", function () {
    expect(res.getBody().result.status).to.equal("OPEN");
  });
}

docs {
  Signup endpoint — deliberately unauthenticated (see collection docs).
  Captures the new account's id into the `senderAccountId` collection variable,
  used by every request downstream.
}
