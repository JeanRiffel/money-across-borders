    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "d": "^1.0.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "mongodb": "^7.0.0",
    "pg": "^8.16.3",
    "pino": "^10.3.1",
