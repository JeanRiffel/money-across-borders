  },
  "scripts": {
    "start": "nodemon --exec bun run src/main/server.ts",
    "dev": "ts-node src/main/server.ts",
    "dev:watch": "nodemon --exec ts-node src/main/server.ts",
    "db:migrate": "ts-node src/infra/persistence/postgresql/migrations/run-migrations.ts",
    "worker:account-created": "ts-node src/infra/events/consumers/account-created-consumer.ts",
    "worker:remittance-indexer": "ts-node src/infra/events/consumers/remittance-completed-indexer.ts",
    "worker:outbox-relay": "ts-node src/infra/events/consumers/outbox-relay.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "cucumber-js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\""
  }
}
